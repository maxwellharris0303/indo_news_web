generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  EDITOR
  ADMIN
  SUPERADMIN
}

enum MembershipPlan {
  FREE
  PLUS
}

enum ArticleStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  CORRECTED
  ARCHIVED
}

enum VerificationStatus {
  verified
  investigation
  hoax
}

enum FactCheckVerdict {
  benar
  salah
  menyesatkan
  tidak_dapat_diverifikasi
}

enum RssScrapeMode {
  RSS_ONLY
  FETCH_ARTICLE
}

enum AiRewriteProvider {
  OPENAI
  ANTHROPIC
}

enum RssItemStatus {
  NEW
  IGNORED
  QUEUED
  REWRITING
  DRAFT_CREATED
  FAILED
}

enum RewriteJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  passwordHash    String?
  image           String?
  role            Role             @default(READER)
  plan            MembershipPlan   @default(FREE)
  interests       String           @default("[]")
  regionSlug      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  sessions        Session[]
  savedArticles   SavedArticle[]
  comments        Comment[]
  readingHistory  ReadingHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Author {
  id       String    @id
  name     String
  title    String?
  bio      String?
  articles Article[]
}

model Region {
  slug     String    @id
  name     String
  province String
  articles Article[]
}

model Topic {
  slug        String         @id
  name        String
  description String
  articles    ArticleTopic[]
}

model Article {
  id                 String             @id
  slug               String
  category           String
  locale             String             @default("id")
  status             ArticleStatus      @default(PUBLISHED)
  scheduledAt        DateTime?
  title              String
  dek                String
  body               String
  aiSummary          String?
  summaryBullets     String
  publishedAt        DateTime
  updatedAt          DateTime?
  correctionNote     String?
  authorId           String
  author             Author             @relation(fields: [authorId], references: [id])
  regionSlug         String?
  region             Region?            @relation(fields: [regionSlug], references: [slug])
  imageUrl           String
  imageCaption       String
  imageCredit        String
  galleryImages      String             @default("[]")
  videoUrl           String?
  verificationStatus VerificationStatus @default(verified)
  sources            String
  featuredLevel      Int                @default(0)
  isBreaking         Boolean            @default(false)
  breakingExpiresAt  DateTime?
  viewCount          Int                @default(0)
  topics             ArticleTopic[]
  savedBy            SavedArticle[]
  comments           Comment[]
  readingHistory     ReadingHistory[]
  rssSourceItem      RssItem?

  @@unique([category, slug])
  @@index([category, publishedAt])
  @@index([regionSlug])
  @@index([status, locale])
}

model ArticleTopic {
  articleId String
  topicSlug String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicSlug], references: [slug], onDelete: Cascade)

  @@id([articleId, topicSlug])
}

model FactCheck {
  slug                String           @id
  claim               String
  verdict             FactCheckVerdict
  explanation         String
  sources             String
  publishedAt         DateTime
  relatedArticleSlugs String           @default("[]")
}

model Comment {
  id         String   @id @default(cuid())
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([articleId, createdAt])
}

model SavedArticle {
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}

model ReadingHistory {
  userId    String
  articleId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  topics    String   @default("[]")
  regionSlug String?
  createdAt DateTime @default(now())
}

model MarketCache {
  id        Int      @id @default(1)
  payload   String
  fetchedAt DateTime @default(now())
}

model RssFeed {
  id                  String         @id @default(cuid())
  name                String
  siteUrl             String
  feedUrl             String         @unique
  enabled             Boolean        @default(true)
  scrapeMode          RssScrapeMode  @default(RSS_ONLY)
  defaultCategory     String         @default("nasional")
  defaultLocale       String         @default("id")
  defaultAiProvider   AiRewriteProvider @default(OPENAI)
  defaultAuthorId     String         @default("a1")
  pollIntervalMinutes Int            @default(30)
  lastFetchedAt       DateTime?
  etag                String?
  lastModified        String?
  lastError           String?
  errorCount          Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  items               RssItem[]
}

model RssItem {
  id             String         @id @default(cuid())
  feedId         String
  feed           RssFeed        @relation(fields: [feedId], references: [id], onDelete: Cascade)
  guid           String
  link           String
  title          String
  summaryRaw     String?
  contentRaw     String?
  extractedBody  String?
  pubDate        DateTime?
  imageUrl       String?
  contentHash    String?
  status         RssItemStatus  @default(NEW)
  articleId      String?        @unique
  article        Article?       @relation(fields: [articleId], references: [id], onDelete: SetNull)
  lastError      String?
  fetchedAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rewriteJobs    RewriteJob[]

  @@unique([feedId, guid])
  @@index([status, pubDate])
  @@index([link])
}

model RewriteJob {
  id            String            @id @default(cuid())
  rssItemId     String
  rssItem       RssItem           @relation(fields: [rssItemId], references: [id], onDelete: Cascade)
  aiProvider    AiRewriteProvider
  scrapeMode    RssScrapeMode
  model         String?
  promptVersion String            @default("v1")
  status        RewriteJobStatus  @default(PENDING)
  outputJson    String?
  error         String?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?

  @@index([rssItemId, createdAt])
}
