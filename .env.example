DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PORT=3000
HOSTNAME=0.0.0.0

# Production (see docs/PRODUCTION.md)
# KABARDESK_PRESERVE_DATA=1
# KABARDESK_DISABLE_DEMO_USERS=1
# AUTH_SECURE_COOKIES=false   # set true after HTTPS + custom domain
# KABARDESK_SUPERADMIN_EMAIL=""
# KABARDESK_SUPERADMIN_PASSWORD=""
# KABARDESK_SEED_DEMO_COMMENTS=0

# RSS AI rewrite (server only)
OPENAI_API_KEY=""
OPENAI_REWRITE_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_REWRITE_MODEL="claude-3-5-haiku-latest"

# Kompas official RSS API (optional — improves Kompas ingest vs Google News only)
KOMPAS_RSS_API_KEY=""

# Bulk auto post (admin): smaller chunks + delays reduce OpenAI/scrape failures
# RSS_AUTO_POST_CHUNK_SIZE=2
# RSS_AUTO_POST_ITEM_DELAY_MS=1500
# RSS_AUTO_POST_CHUNK_DELAY_MS=2500
